{
  "manifest_version": 3,
  "name": "Distraction Block",
  "version": "1.0.2",
  "description": "Bloqueia os sites e as pesquisas que você definir no site do Distraction Block.",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Distraction Block",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "alarms",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "incognito": "spanning",
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html",
        "blocked.css",
        "blocked.js",
        "theme.css",
        "messages.js",
        "logo-white.png",
        "fonts/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://distractionblock.vercel.app/*",
        "https://rvazh.github.io/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["ponte.js"],
      "run_at": "document_start"
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://distractionblock.vercel.app/*",
      "https://rvazh.github.io/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  }
}
